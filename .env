# Anon-Connect Environment Configuration
# Development settings - safe defaults for local development

# Application Environment
NODE_ENV=development
PORT=3002

# Security Keys (Auto-generated for development)
SECRET_KEY=anon-connect-dev-secret-key-12345
SESSION_SECRET=anon-connect-session-secret-67890

# OpenAI Configuration (Optional - for AI features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Admin Configuration
ADMIN_EMAIL=admin@example.com

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Database Configuration
DATABASE_PATH=./anon_connect.db

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_DEBUG_MODE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
