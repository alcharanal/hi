# Anon-Connect Production Environment Configuration
# Copy this file to .env and update the values for production

# Application Environment
NODE_ENV=production
PORT=3002

# Security Keys - CHANGE THESE FOR PRODUCTION!
# Generate strong keys: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_KEY_MINIMUM_32_CHARS

# OpenAI Configuration (Optional - for AI features)
OPENAI_API_KEY=

# Admin Configuration
ADMIN_EMAIL=admin@yourdomain.com

# CORS Configuration - Update with your actual domain
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Redis Configuration (for session storage and caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# Database Configuration
DATABASE_PATH=./data/anon_connect.db

# Monitoring Configuration
ENABLE_MONITORING=true
METRICS_PORT=9090

# SSL Configuration (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
MAX_LOG_FILES=10
MAX_LOG_SIZE=10485760

# Email Configuration (for notifications - optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Backup Configuration
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=./backups

# Performance Configuration
MAX_CONCURRENT_CONNECTIONS=1000
SOCKET_IO_TRANSPORTS=websocket,polling
ENABLE_COMPRESSION=true

# Security Configuration
ENABLE_RATE_LIMITING=true
ENABLE_HELMET=true
TRUST_PROXY=true
SECURE_COOKIES=true
SAME_SITE_COOKIES=strict

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_DEBUG_MODE=false
